<view class="hero"><text class="title">青禾鲜选</text><text>让每一餐，都有新鲜好滋味</text><text>{{settings.announcement}}</text></view>
<view class="panel"><text>{{message}}</text><checkbox-group bindchange="consent"><label><checkbox value="yes"/>我已知晓：本地演示仅存储订单所需信息，请勿填写真实个人信息；清理本地数据可删除记录。</label></checkbox-group><picker range="{{['顾客','骑手']}}" bindchange="chooseRole"><view>角色：{{role==='customer'?'顾客':'骑手'}}（点击切换）</view></picker><input password placeholder="本地访问令牌（演示可留空）" data-field="loginToken" bindinput="field"/><button bindtap="login">连接本地演示</button></view>
<view class="tabs"><button data-tab="shop" bindtap="tab">逛鲜选</button><button data-tab="cart" bindtap="tab">购物车</button><button data-tab="orders" bindtap="tab">{{role==='rider'?'配送任务':'我的订单'}}</button></view>
<view wx:if="{{tab==='shop'}}"><input class="search" placeholder="搜索今天想吃的" data-field="query" bindinput="field"/><scroll-view scroll-x><view class="categories"><text wx:for="{{categories}}" wx:key="*this" data-value="{{item}}" bindtap="category">{{item}}</text></view></scroll-view><view class="grid"><view class="product" wx:for="{{visible}}" wx:key="id"><image wx:if="{{item.image.url}}" src="{{item.image.url}}" mode="aspectFit" class="product-image"/><text wx:else class="emoji">{{item.emoji || '🌱'}}</text><text class="hint">{{item.image.url?'商家审核商品图':'通用示意图'}}</text><text>{{item.name}}</text><text class="hint">{{item.spec}} · 库存 {{item.stock}}</text><text>¥{{item.price / 100}}</text><button size="mini" data-id="{{item.id}}" data-delta="1" bindtap="add">加入购物车</button></view></view></view>
<view class="panel" wx:if="{{tab==='cart'}}"><view wx:for="{{products}}" wx:key="id"><view wx:if="{{cart[item.id] > 0}}">{{item.name}} × {{cart[item.id]}}<button size="mini" data-id="{{item.id}}" data-delta="-1" bindtap="add">－</button><button size="mini" data-id="{{item.id}}" data-delta="1" bindtap="add">＋</button></view></view><text>商品合计 ¥{{total}}（服务端复核运费）</text><input placeholder="收货人（虚构）" data-field="name" bindinput="field"/><input placeholder="手机号（测试号码）" data-field="phone" bindinput="field"/><input placeholder="详细地址（虚构）" data-field="address" bindinput="field"/><button size="mini" bindtap="saveAddress">保存演示地址</button><picker range="{{addresses}}" range-key="address" bindchange="selectAddress"><view>选择已保存地址</view></picker><picker range="{{settings.areas}}" bindchange="chooseArea"><view>配送社区：{{area}}</view></picker><picker range="{{settings.slots}}" bindchange="chooseSlot"><view>配送时段：{{slot}}</view></picker><button bindtap="checkout">创建模拟订单</button></view>
<view wx:if="{{tab==='orders'}}"><button bindtap="loadOrders">刷新订单</button><view class="panel" wx:for="{{orders}}" wx:key="id"><text>{{item.id}}</text><text>{{item.status}} · ¥{{item.displayTotal}}</text><text>{{item.contact.address}}</text><text wx:if="{{role==='rider'}}">联系顾客：{{item.contact.phone}}</text><view wx:if="{{item.status==='delivered' && role==='customer'}}"><input placeholder="售后原因" data-field="refundReason" bindinput="field"/><button data-id="{{item.id}}" bindtap="aftersales">申请售后</button></view><view wx:if="{{role==='rider' && (item.status==='assigned'||item.status==='delivering')}}"><input placeholder="配送异常原因" data-field="exceptionReason" bindinput="field"/><button data-id="{{item.id}}" bindtap="exception">报告异常</button></view><button wx:if="{{item.status==='pending' && role==='customer'}}" data-id="{{item.id}}" data-action="pay" bindtap="orderAction">模拟付款（不扣款）</button><button wx:if="{{(item.status==='pending'||item.status==='paid') && role==='customer'}}" data-id="{{item.id}}" data-action="cancel" bindtap="orderAction">确认取消 / 模拟退款</button><button wx:if="{{item.status==='assigned' && role==='rider'}}" data-id="{{item.id}}" data-action="transition" data-status="delivering" bindtap="orderAction">确认取货</button><button wx:if="{{item.status==='delivering' && role==='rider'}}" data-id="{{item.id}}" data-action="transition" data-status="delivered" bindtap="orderAction">确认送达</button></view></view>
